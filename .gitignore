# Local environment and secrets. Keep the safe template tracked.
/.env
/.env.*
!/.env.example
/auth.json

# PHP and test artifacts.
/vendor/
/.phpunit.cache/
/.phpunit.result.cache
/.phpactor.json
/coverage/
/bootstrap/cache/*.php

# Node and compiled frontend assets.
/node_modules/
/public/build/
/public/hot
/public/storage
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime files, uploads, and local database data.
/storage/*.key
/storage/logs/*.log
/storage/app/private/*
!/storage/app/private/.gitignore
/storage/app/public/uploads/
/database/*.sqlite
/database/*.sqlite-*
/database/dumps/

# Local editor and operating-system files.
/.fleet/
/.idea/
/.nova/
/.vscode/
/.zed/
.DS_Store
Thumbs.db
